# ============================================================================
#  Parque Actún Kan — backend. Plantilla de variables de entorno.
#
#  Copie este archivo como `.env` y rellene los valores. Aquí solo van NOMBRES y
#  ejemplos: nunca un secreto real, porque este archivo sí se versiona.
#
#  Para el despliegue basta cambiar los dos dominios de la primera sección: todo
#  lo demás se deriva de ellos. Al arrancar, el servidor imprime las URL que va a
#  usar y avisa de lo que falte, así que esa primera línea del log es la forma de
#  comprobar que el despliegue quedó bien.
# ============================================================================

# --- Dominios -----------------------------------------------------------------
# APP_URL  es el frontend, lo que el visitante ve en la barra del navegador.
# API_URL  es este backend, la dirección por la que lo alcanza el navegador y la
#          pasarela. Puede ser un subdominio o una ruta detrás del mismo proxy.
#
# De APP_URL se derivan solas las URL de retorno del pago, y de API_URL la URL
# que hay que registrar como webhook en Recurrente. Sin barra al final.
APP_URL=https://app.sudominio.com
API_URL=https://api.sudominio.com

# Puerto en el que escucha el proceso. Detrás de un proxy inverso no es el que
# ve el público: ese sale de API_URL.
PORT=4000

# --- Seguridad de red ---------------------------------------------------------
# Orígenes que el navegador puede usar para llamar a esta API. Déjelo VACÍO si
# solo hay un frontend: se usa APP_URL. Rellénelo solo si son varios dominios,
# separados por coma (ej. https://app.sudominio.com,https://admin.sudominio.com).
# Vacío y sin APP_URL, la API queda abierta a cualquier origen: aceptable en
# desarrollo, nunca en producción.
CORS_ORIGINS=

# Póngalo en true cuando haya un proxy inverso al frente (nginx, Cloudflare).
# Sin esto el límite de peticiones cuenta a todos los clientes como uno solo, y
# un solo usuario activo bloquearía al resto. Expuesto directo a internet
# déjelo en false: permitiría falsificar la IP con X-Forwarded-For.
TRUST_PROXY=true

# --- Base de datos ------------------------------------------------------------
DATABASE_URL=sqlserver://HOST:1433;database=parque_tickets;user=USUARIO;password=CONTRASENA;encrypt=true;trustServerCertificate=true

# --- Sesiones -----------------------------------------------------------------
# Mínimo 32 caracteres. Sin esto la aplicación no arranca, a propósito: un
# secreto por defecto permitiría firmar tokens de cualquier usuario.
JWT_SECRET=
JWT_ACCESS_EXPIRA=30m

# --- Límite de peticiones -----------------------------------------------------
THROTTLE_TTL_SEGUNDOS=60
THROTTLE_LIMITE=120

# --- Pasarela de pago (Recurrente) --------------------------------------------
# sk_live_... cobra dinero real. Para probar use la llave TEST del Sandbox.
RECURRENTE_SECRET_KEY=
RECURRENTE_API_URL=https://app.recurrente.com/api

# Secreto de firma del webhook. Recurrente lo entrega UNA SOLA VEZ, al registrar
# el endpoint, y es distinto por endpoint: el de prueba y el de producción no son
# el mismo. Mientras esté vacío, POST /webhooks/recurrente responde 503 y los
# cobros con tarjeta no se confirman —el sistema arranca igual y se puede seguir
# vendiendo en efectivo—.
#
# La URL a registrar es:  <API_URL>/webhooks/recurrente
RECURRENTE_WEBHOOK_SECRET=

# Solo si necesita rutas de retorno distintas de las que se derivan de APP_URL.
# Normalmente se dejan vacías.
RECURRENTE_SUCCESS_URL=
RECURRENTE_CANCEL_URL=

# --- Firma de los pases -------------------------------------------------------
# Secreto del QR y serie del folio. Cambiar TICKET_QR_SECRET invalida todos los
# pases ya impresos.
TICKET_QR_SECRET=
TICKET_SERIE=TCK

# --- Correo -------------------------------------------------------------------
# Sin SMTP el sistema funciona: el enlace de pago y el código de restablecimiento
# se registran en el log en vez de enviarse.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# Déjelo en true en producción: en false no se valida el certificado TLS del
# servidor de correo y la conexión admite un intermediario.
SMTP_REJECT_UNAUTHORIZED=true
SMTP_FROM="Parque Aktun Kan" <noreply@sudominio.com>

# --- Reportes con IA ----------------------------------------------------------
# Opcional. Sin llave, los reportes funcionan y solo deja de estar la pestaña que
# interpreta peticiones en lenguaje natural.
IA_BASE_URL=https://api.groq.com/openai/v1/chat/completions
IA_MODELO=
IA_MODELO_RESPALDO=
IA_API_KEY=
