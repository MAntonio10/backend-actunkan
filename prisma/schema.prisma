// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

/// Sesión de refresco. El token de acceso dura minutos; este es el que permite
/// renovarlo y es revocable de forma individual: cerrar una sesión no afecta
/// a las demás del mismo usuario ni a las de otros usuarios.
///
/// Se guarda solo el hash del token: si la base de datos se filtrara, los
/// valores almacenados no sirven para autenticarse.
model SesionRefresh {
  id               Int       @id @default(autoincrement())
  idUsuario        Int
  tokenHash        String    @unique @db.NVarChar(128)
  fechaCreacion    DateTime  @db.DateTime2
  fechaExpiracion  DateTime  @db.DateTime2
  fechaUltimoUso   DateTime? @db.DateTime2
  revocada         Boolean   @default(false)
  motivoRevocacion String?   @db.NVarChar(120)
  ip               String?   @db.NVarChar(64)
  dispositivo      String?   @db.NVarChar(255)

  usuario Usuario @relation(fields: [idUsuario], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([idUsuario, revocada])
}

model Usuario {
  id                   Int                 @id @default(autoincrement())
  idPuesto             Int
  nombre               String              @db.NVarChar(255)
  correo               String              @unique @db.NVarChar(255)
  contrasena           String              @db.NVarChar(255)
  telefono             String?             @db.NVarChar(50)
  fechaCreacion        DateTime            @db.DateTime2
  fechaActualizacion   DateTime            @db.DateTime2
  anulado              Boolean             @default(false)
  codigoRestablecimiento String?           @db.NVarChar(10)
  expiracionCodigo       DateTime?         @db.DateTime2
  aperturasCaja        AperturaCaja[]
  tickets              Ticket[]
  gruposEmision        GrupoEmision[]
  donaciones           Donacion[]
  sesiones             SesionRefresh[]
  permiso              Permisos[]
  puesto               Puestos             @relation(fields: [idPuesto], references: [id])
  actividadesCreadas   ActividadesParque[] @relation("ActividadCreador")
  actividadesAsignadas ActividadesParque[] @relation("ActividadResponsable")
  bitacora             Bitacora[]
}

model Modulo {
  id                 Int       @id @default(autoincrement())
  nombre             String    @unique @db.NVarChar(100)
  anulado            Boolean   @default(false)
  fechaCreacion      DateTime  @default(now()) @db.DateTime2
  fechaActualizacion DateTime? @updatedAt @db.DateTime2

  /// Módulos de infraestructura ('Modulos', 'Acciones'): existen para que el
  /// frontend arme el menú y la pantalla de permisos, pero no se conceden a
  /// ningún usuario. No aparecen en la asignación y la API rechaza asignarlos.
  esAsignable Boolean @default(true)

  /// Un módulo general puede agrupar sub-módulos con permisos propios
  /// Null = módulo general.
  idModuloPadre Int?
  moduloPadre   Modulo?  @relation("SubModulos", fields: [idModuloPadre], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subModulos    Modulo[] @relation("SubModulos")

  // Relación con las acciones que este módulo permite tener
  moduloAcciones ModuloAccion[]
}

model Accion {
  id     Int    @id @default(autoincrement())
  // Aquí guardarás valores como: "ver", "agregar", "editar", "anular", "exportar"
  nombre String @unique @db.NVarChar(50)

  moduloAcciones ModuloAccion[]
}

// Esta tabla define qué acciones aplican a qué módulo
model ModuloAccion {
  id       Int @id @default(autoincrement())
  idModulo Int
  idAccion Int

  modulo   Modulo     @relation(fields: [idModulo], references: [id])
  accion   Accion     @relation(fields: [idAccion], references: [id])
  permisos Permisos[]

  // Un módulo no puede tener la misma acción duplicada
  @@unique([idModulo, idAccion])
}

// La asignación final al usuario
model Permisos {
  id             Int @id @default(autoincrement())
  idUsuario      Int
  idModuloAccion Int

  usuario      Usuario      @relation(fields: [idUsuario], references: [id])
  moduloAccion ModuloAccion @relation(fields: [idModuloAccion], references: [id])

  // Un usuario no debería tener el mismo permiso asignado dos veces
  @@unique([idUsuario, idModuloAccion])
}

model Puestos {
  id                 Int       @id @default(autoincrement())
  nombre             String    @unique @db.NVarChar(100)
  descripcion        String?   @db.NVarChar(Max)
  anulado            Boolean   @default(false)
  fechaCreacion      DateTime  @db.DateTime2
  fechaActualizacion DateTime? @db.DateTime2
  usuarios           Usuario[]
}

/// Una venta puede emitir 1 o 2 tickets (visitante y, si el guía no tiene carnet,
/// un ticket independiente para el guía). GrupoEmision los vincula.
model GrupoEmision {
  id             Int          @id @default(autoincrement())
  idUsuario      Int
  idAperturaCaja Int
  fechaCreacion  DateTime     @db.DateTime2
  usuario        Usuario      @relation(fields: [idUsuario], references: [id], onDelete: NoAction, onUpdate: NoAction)
  aperturaCaja   AperturaCaja @relation(fields: [idAperturaCaja], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tickets        Ticket[]
}

model Ticket {
  id                 Int           @id @default(autoincrement())
  idGrupoEmision     Int
  idTipoRecorrido    Int
  idAperturaCaja     Int
  idUsuario          Int
  idAtraccion        Int
  idOrigen           Int
  idPais             Int?
  idGuia             Int?
  /// Folio correlativo. Siempre texto: puede llevar letras (serie configurable).
  numeroTicket       String        @unique @db.NVarChar(30)
  /// 'VISITANTE' | 'GUIA'
  tipoTicket         String        @db.NVarChar(20)
  nombre             String        @db.NVarChar(255)
  cantidadPersonas   Int
  montoTotal         Decimal       @db.Decimal(18, 4)
  observaciones      String?       @db.NVarChar(Max)
  fechaCreacion      DateTime      @db.DateTime2
  fechaActualizacion DateTime?     @db.DateTime2
  anulado            Boolean       @default(false)
  /// Firma HMAC del folio; es lo que valida el QR en taquilla.
  qrFirma            String        @db.NVarChar(128)
  /// Control de acceso: se sella al primer escaneo válido.
  fechaUso           DateTime?     @db.DateTime2
  idUsuarioUso       Int?

  grupoEmision  GrupoEmision    @relation(fields: [idGrupoEmision], references: [id])
  tipoRecorrido TipoRecorrido   @relation(fields: [idTipoRecorrido], references: [id])
  aperturaCaja  AperturaCaja    @relation(fields: [idAperturaCaja], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario       Usuario         @relation(fields: [idUsuario], references: [id], onDelete: NoAction, onUpdate: NoAction)
  atraccion     Atraccion       @relation(fields: [idAtraccion], references: [id])
  origen        OrigenVisitante @relation(fields: [idOrigen], references: [id])
  pais          Pais?           @relation(fields: [idPais], references: [id])
  guia          Guia?           @relation(fields: [idGuia], references: [id])

  visitantePorTickets VisitantePorTicket[]
  ticketPagos         TicketPago[]

  @@index([fechaCreacion])
  @@index([idAperturaCaja])
}

model VisitantePorTicket {
  id              Int           @id @default(autoincrement())
  idTicket        Int
  idTipoVisitante Int
  cantidad        Int
  /// Snapshot de la tarifa aplicada: cambiar precios no debe alterar ventas pasadas.
  precioUnitario  Decimal       @db.Decimal(18, 4)
  subtotal        Decimal       @db.Decimal(18, 4)
  tickets         Ticket        @relation(fields: [idTicket], references: [id])
  tipoVisitantes  TipoVisitante @relation(fields: [idTipoVisitante], references: [id])

  @@unique([idTicket, idTipoVisitante])
}

model TipoRecorrido {
  id                 Int       @id @default(autoincrement())
  /// Clave estable para reglas de negocio: 'corto' | 'largo'.
  codigo             String    @unique @db.NVarChar(50)
  nombre             String
  fechaCreacion      DateTime  @db.DateTime2
  fechaActualizacion DateTime? @db.DateTime2
  anulado            Boolean   @default(false)
  tickets            Ticket[]
}

model TipoVisitante {
  id                  Int                  @id @default(autoincrement())
  /// 'adulto' | 'nino' | 'nino_menor' | 'centro_educativo'.
  codigo              String               @unique @db.NVarChar(50)
  nombre              String               @db.NVarChar(255)
  fechaCreacion       DateTime             @db.DateTime2
  fechaActualizacion  DateTime?            @db.DateTime2
  anulado             Boolean              @default(false)
  visitantePorTickets VisitantePorTicket[]
  tarifas             Tarifa[]
}

model Atraccion {
  id                 Int       @id @default(autoincrement())
  /// 'cuevas' | 'mariposario'.
  codigo             String    @unique @db.NVarChar(50)
  nombre             String    @db.NVarChar(255)
  fechaCreacion      DateTime  @db.DateTime2
  fechaActualizacion DateTime? @db.DateTime2
  anulado            Boolean   @default(false)
  tickets            Ticket[]
  tarifas            Tarifa[]
}

model OrigenVisitante {
  id                 Int       @id @default(autoincrement())
  /// 'nacional' | 'extranjero'. Extranjero exige país y excluye centro_educativo.
  codigo             String    @unique @db.NVarChar(50)
  nombre             String    @db.NVarChar(255)
  fechaCreacion      DateTime  @db.DateTime2
  fechaActualizacion DateTime? @db.DateTime2
  anulado            Boolean   @default(false)
  tickets            Ticket[]
  tarifas            Tarifa[]
}

model Pais {
  id                 Int       @id @default(autoincrement())
  nombre             String    @unique @db.NVarChar(150)
  codigoIso          String?   @db.NVarChar(3)
  fechaCreacion      DateTime  @db.DateTime2
  fechaActualizacion DateTime? @db.DateTime2
  anulado            Boolean   @default(false)
  tickets            Ticket[]
}

model Guia {
  id                 Int       @id @default(autoincrement())
  nombre             String    @db.NVarChar(255)
  numeroCarnet       String?   @db.NVarChar(50)
  tieneCarnet        Boolean   @default(false)
  fechaCreacion      DateTime  @db.DateTime2
  fechaActualizacion DateTime? @db.DateTime2
  anulado            Boolean   @default(false)
  tickets            Ticket[]
}

/// Tarifa por atracción + origen + categoría, con vigencia.
/// La vigente es la que tiene vigenteHasta = null; editar cierra la anterior y crea otra.
model Tarifa {
  id                 Int             @id @default(autoincrement())
  idAtraccion        Int
  idOrigen           Int
  idTipoVisitante    Int
  precio             Decimal         @db.Decimal(18, 4)
  vigenteDesde       DateTime        @db.DateTime2
  vigenteHasta       DateTime?       @db.DateTime2
  fechaCreacion      DateTime        @db.DateTime2
  fechaActualizacion DateTime?       @db.DateTime2
  anulado            Boolean         @default(false)
  atraccion          Atraccion       @relation(fields: [idAtraccion], references: [id])
  origen             OrigenVisitante @relation(fields: [idOrigen], references: [id])
  tipoVisitante      TipoVisitante   @relation(fields: [idTipoVisitante], references: [id])

  @@index([idAtraccion, idOrigen, idTipoVisitante, vigenteHasta])
}

/// Precio del ticket independiente del guía sin carnet. No depende de la atracción.
model TarifaGuia {
  id                 Int       @id @default(autoincrement())
  precio             Decimal   @db.Decimal(18, 4)
  vigenteDesde       DateTime  @db.DateTime2
  vigenteHasta       DateTime? @db.DateTime2
  fechaCreacion      DateTime  @db.DateTime2
  fechaActualizacion DateTime? @db.DateTime2
}

/// Contador atómico de folios, compartido por documentos con numeración propia:
/// tickets (`TCK`) y recibos de donación (`DON`). Cada serie lleva su contador por año.
///
/// Solo el consecutivo es numérico; el folio que se persiste es la cadena compuesta.
/// Conserva el nombre de tabla original para no perder los contadores existentes.
model Correlativo {
  id           Int    @id @default(autoincrement())
  serie        String @db.NVarChar(10)
  anio         Int
  ultimoNumero Int    @default(0)

  @@unique([serie, anio])
  @@map("CorrelativoTicket")
}

/// Donación recibida en ventanilla. Solo efectivo, y entra a la caja abierta:
/// por eso suma al arqueo igual que una venta.
///
/// El recibo que se entrega es **no contable**: no tiene validez fiscal.
model Donacion {
  id                 Int          @id @default(autoincrement())
  /// Folio correlativo del recibo, ej. `DON-2026-000001`. Siempre texto.
  numeroRecibo       String       @unique @db.NVarChar(30)
  idAperturaCaja     Int
  idUsuario          Int
  /// Opcional: se admiten donaciones anónimas.
  nombreDonante      String?      @db.NVarChar(255)
  monto              Decimal      @db.Decimal(18, 4)
  observaciones      String?      @db.NVarChar(Max)
  fechaCreacion      DateTime     @db.DateTime2
  fechaActualizacion DateTime?    @db.DateTime2
  anulado            Boolean      @default(false)
  motivoAnulacion    String?      @db.NVarChar(255)

  aperturaCaja AperturaCaja @relation(fields: [idAperturaCaja], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuario      Usuario      @relation(fields: [idUsuario], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([fechaCreacion])
  @@index([idAperturaCaja])
}

model OpcionPago {
  id                 Int          @id @default(autoincrement())
  nombre             String       @db.NVarChar(100)
  esEfectivo         Boolean      @default(false)
  anulado            Boolean      @default(false)
  fechaCreacion      DateTime     @db.DateTime2
  fechaActualizacion DateTime?    @db.DateTime2
  ticketsPago        TicketPago[]
}

model TicketPago {
  id                 Int        @id @default(autoincrement())
  idTicket           Int
  idOpcionPago       Int
  numeroComprobante  String?    @db.NVarChar(100)
  /// ID del checkout en la pasarela (Recurrente), ej. `ch_eegw9j5zgqoae3ms`.
  idPagoPasarela     String?    @db.NVarChar(255)
  /// Link de pago que se le comparte al cliente por correo o WhatsApp.
  checkoutUrl        String?    @db.NVarChar(500)
  /// 'PAGADO' | 'PENDIENTE' | 'CANCELADO'.
  /// El efectivo nace PAGADO; la tarjeta queda PENDIENTE hasta que la pasarela confirme.
  estadoPago         String     @default("PAGADO") @db.NVarChar(20)
  fechaPago          DateTime?  @db.DateTime2
  monto              Decimal    @db.Decimal(18, 4)
  fechaCreacion      DateTime   @db.DateTime2
  fechaActualizacion DateTime?  @db.DateTime2
  anulado            Boolean    @default(false)
  tickets            Ticket     @relation(fields: [idTicket], references: [id])
  opcionPago         OpcionPago @relation(fields: [idOpcionPago], references: [id])

  @@index([idPagoPasarela])
}

model AperturaCaja {
  id                 Int          @id @default(autoincrement())
  idUsuario          Int
  fechaCreacion      DateTime     @db.DateTime2
  fechaActualizacion DateTime?    @db.DateTime2
  idEstado           Int
  montoInicial       Decimal      @db.Decimal(18, 4)
  observaciones      String?      @db.NVarChar(Max)
  anulado            Boolean      @default(false)
  usuario            Usuario        @relation(fields: [idUsuario], references: [id])
  cierresCaja        CierreCaja[]
  tickets            Ticket[]
  gruposEmision      GrupoEmision[]
  donaciones         Donacion[]
  estado             EstadoCaja     @relation(fields: [idEstado], references: [id])
}

model EstadoCaja {
  id       Int            @id @default(autoincrement())
  nombre   String         @db.NVarChar(255)
  apertura AperturaCaja[]
}

model CierreCaja {
  id             Int          @id @default(autoincrement())
  idApertura     Int
  fechaCierre    DateTime     @db.DateTime2
  montoFinal     Decimal      @db.Decimal(18, 4)
  montoEsperado  Decimal?     @db.Decimal(18, 4)
  diferencia     Decimal?     @db.Decimal(18, 4)
  observaciones  String?      @db.NVarChar(Max)
  anulado        Boolean      @default(false)
  aperturaCaja   AperturaCaja @relation(fields: [idApertura], references: [id])
}

model ActividadesParque {
  id                   Int          @id @default(autoincrement())
  idSectorParque       Int
  idUsuarioCreador     Int
  idUsuarioResponsable Int
  nombreActividad      String
  fechaCreacion        DateTime     @db.DateTime2
  fechaActualizacion   DateTime?    @db.DateTime2
  descripcionActividad String
  imagen               String?
  anulado              Boolean      @default(false)
  usuarios             Usuario      @relation("ActividadCreador", fields: [idUsuarioCreador], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuariosAsignado     Usuario      @relation("ActividadResponsable", fields: [idUsuarioResponsable], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sector               SectorParque @relation(fields: [idSectorParque], references: [id])
}

model SectorParque {
  id                 Int                 @id @default(autoincrement())
  nombre             String              @db.NVarChar(255)
  fechaCreacion      DateTime            @db.DateTime2
  fechaActualizacion DateTime?           @db.DateTime2
  anulado            Boolean             @default(false)
  actividades        ActividadesParque[]
}

model Bitacora {
  id            Int      @id @default(autoincrement())
  idUsuario     Int?
  usuarioNombre String?  @db.NVarChar(255)
  accion        String   @db.NVarChar(100)
  modulo        String   @db.NVarChar(100)
  descripcion   String   @db.NVarChar(Max)
  fecha         DateTime @db.DateTime2

  usuario       Usuario? @relation(fields: [idUsuario], references: [id], onDelete: SetNull)
}

